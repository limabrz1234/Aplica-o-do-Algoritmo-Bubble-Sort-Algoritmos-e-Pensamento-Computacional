#include <stdio.h>

#define TAMANHO 10

/*
 * Projeto: Controle Financeiro
 * Objetivo: organizar 10 despesas do maior valor para o menor
 * utilizando o algoritmo Bubble Sort.
 */

/* Mostra as despesas armazenadas no array. */
void mostrarDespesas(float despesas[], int tamanho) {
    int i;

    for (i = 0; i < tamanho; i++) {
        printf("%d. R$ %.2f\n", i + 1, despesas[i]);
    }
}

/* Ordena as despesas em ordem decrescente com Bubble Sort. */
void bubbleSort(float despesas[], int tamanho) {
    int i, j;
    float auxiliar;
    int trocou;

    /*
     * Cada passagem coloca mais um dos menores valores
     * na posição correta, ao final do array.
     */
    for (i = 0; i < tamanho - 1; i++) {
        trocou = 0;

        /*
         * Compara elementos adjacentes e troca quando
         * o elemento da esquerda é menor que o da direita.
         */
        for (j = 0; j < tamanho - 1 - i; j++) {
            if (despesas[j] < despesas[j + 1]) {
                auxiliar = despesas[j];
                despesas[j] = despesas[j + 1];
                despesas[j + 1] = auxiliar;

                trocou = 1;
            }
        }

        /* Encerra antes se nenhuma troca tiver ocorrido. */
        if (trocou == 0) {
            break;
        }
    }
}

int main(void) {
    float despesas[TAMANHO];
    int i;

    printf("====================================\n");
    printf("     CONTROLE FINANCEIRO\n");
    printf("====================================\n");
    printf("Informe os valores de 10 despesas.\n\n");

    /* Lê e valida os valores digitados pelo usuário. */
    for (i = 0; i < TAMANHO; i++) {
        printf("Digite o valor da despesa %d (R$): ", i + 1);

        if (scanf("%f", &despesas[i]) != 1 || despesas[i] < 0) {
            printf("Entrada invalida! Digite um valor nao negativo.\n");
            return 1;
        }
    }

    printf("\n--- DESPESAS ANTES DA ORDENACAO ---\n");
    mostrarDespesas(despesas, TAMANHO);

    bubbleSort(despesas, TAMANHO);

    printf("\n--- DESPESAS APOS A ORDENACAO ---\n");
    printf("Criterio: ordem decrescente (maior para menor).\n\n");
    mostrarDespesas(despesas, TAMANHO);

    printf("\nOrdenacao concluida com sucesso!\n");

    return 0;
}
